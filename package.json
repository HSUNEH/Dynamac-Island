{
  "name": "dynamac-island",
  "version": "0.1.0",
  "description": "Local macOS-testable Dynamic-Island-style status panel for Snuffles, Codex, and Ouroboros.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "npm run check-readme && npm run test:check-readme-script && npm run test:install-macbook-script && npm run test:package-mac-script && npm run test:packaged-status-path && npm run test:status-schema && npm run test:timer-duration && npm run test:timer-state && npm run test:timer-countdown && npm run test:timer-start-entrypoint && npm run test:timer-status && npm run test:timer-status-store && npm run test:timer-controller && npm run test:timer-ui && npm run test:renderer-timer-stop && npm run test:renderer-timer-state-changes && npm run test:mac-activity-status && npm run test:youtube-media-bridge-content && npm run test:start-arc-media && npm run test:enable-browser-apple-events && npm run test:hermes-status && npm run test:status-loader && npm run test:status-watcher && npm run test:status-edit-event && npm run test:renderer-real-hermes-payload && npm run test:renderer-compact-summary && npm run test:renderer-timer-reset && npm run test:app-state && npm run test:snuffles-state && npm run test:snuffles-view-model && npm run test:snuffles-ui-view && npm run test:codex-state && npm run test:codex-view-model && npm run test:codex-ui-view && npm run test:ouroboros-state && npm run test:ouroboros-view-model && npm run test:ouroboros-ui-view && npm run test:window-config && npm run test:notch-position && npm run test:island-mode && npm run test:pill-view && npm run test:app-composition && npm run test:main-process && npm run test:native-overlay-contract && npm run test:native-timer-status-serialization && npm run test:native-timer-state-changes && npm run test:browser-probe-isolation && npm run native:smoke && npm run test:check-status-script && npm run test:check-status-valid-fixture && npm run test:check-status-malformed-fixture && npm run test:check-status-missing-required-fixture && npm run test:check-status-unsupported-state-fixture && npm run check-status && npm run check-status:valid",
    "check-readme": "node scripts/check-readme.js",
    "smoke:launch": "node scripts/smoke-launch.js",
    "native:build": "mkdir -p .build && swiftc native/DynamacIslandNative.swift -o .build/dynamac-native",
    "status:write": "node scripts/write-mac-activity-status.js .build/status.json",
    "diagnose:youtube": "node scripts/diagnose-youtube-media.js",
    "youtube-bridge": "node scripts/youtube-media-bridge-server.js",
    "start:arc-media": "node scripts/start-arc-media.js",
    "start:chrome-media": "open -na 'Google Chrome' --args --load-extension=\"$PWD/extensions/youtube-media-bridge\"",
    "start:arc-cdp": "open -na Arc --args --remote-debugging-port=9222",
    "measure:spotify-artwork": "node scripts/measure-spotify-artwork-latency.js",
    "enable:browser-apple-events": "node scripts/enable-browser-apple-events.js",
    "native:start": "node scripts/native-start.js",
    "native:calibrate": "node scripts/notch-calibrate.js",
    "native:smoke": "npm run native:build && DYNAMAC_NATIVE_SMOKE_TEST=1 DYNAMAC_STATUS_FILE=status/status.json ./.build/dynamac-native",
    "setup:macbook": "bash scripts/install-macbook.sh",
    "package:mac": "node scripts/package-mac.js",
    "check-status": "node scripts/check-status.js",
    "check-status:valid": "node scripts/check-status.js fixtures/valid-status.json",
    "check-status:invalid": "node scripts/check-status.js fixtures/invalid-status.json",
    "check-status:malformed": "node scripts/check-status.js fixtures/malformed-status.json",
    "check-status:missing-required": "node scripts/check-status.js fixtures/missing-required-status.json",
    "check-status:unsupported-state": "node scripts/check-status.js fixtures/unsupported-state-status.json",
    "test:check-readme-script": "node scripts/test-check-readme-script.js",
    "test:install-macbook-script": "node scripts/test-install-macbook-script.js",
    "test:package-mac-script": "node scripts/test-package-mac-script.js",
    "test:packaged-status-path": "node scripts/test-packaged-status-path.js",
    "test:check-status-script": "node scripts/test-check-status-script.js",
    "test:check-status-malformed-fixture": "node scripts/test-check-status-malformed-fixture.js",
    "test:check-status-missing-required-fixture": "node scripts/test-check-status-missing-required-fixture.js",
    "test:check-status-unsupported-state-fixture": "node scripts/test-check-status-unsupported-state-fixture.js",
    "test:check-status-valid-fixture": "node scripts/test-check-status-valid-fixture.js",
    "test:codex-state": "node scripts/test-codex-state.js",
    "test:codex-ui-view": "node scripts/test-codex-ui-view.js",
    "test:codex-view-model": "node scripts/test-codex-view-model.js",
    "test:ouroboros-state": "node scripts/test-ouroboros-state.js",
    "test:ouroboros-ui-view": "node scripts/test-ouroboros-ui-view.js",
    "test:ouroboros-view-model": "node scripts/test-ouroboros-view-model.js",
    "test:snuffles-state": "node scripts/test-snuffles-state.js",
    "test:snuffles-ui-view": "node scripts/test-snuffles-ui-view.js",
    "test:snuffles-view-model": "node scripts/test-snuffles-view-model.js",
    "test:app-state": "node scripts/test-app-state.js",
    "test:status-loader": "node scripts/test-status-loader.js",
    "test:timer-duration": "node scripts/test-timer-duration.js",
    "test:timer-state": "node scripts/test-timer-state.js",
    "test:timer-countdown": "node scripts/test-timer-countdown.js",
    "test:timer-start-entrypoint": "node scripts/test-timer-start-entrypoint.js",
    "test:timer-status": "node scripts/test-timer-status.js",
    "test:timer-status-store": "node scripts/test-timer-status-store.js",
    "test:timer-controller": "node scripts/test-timer-controller.js",
    "test:timer-ui": "node scripts/test-timer-ui.js",
    "test:renderer-timer-stop": "node scripts/test-renderer-timer-stop.js",
    "test:renderer-timer-state-changes": "node scripts/test-renderer-timer-state-changes.js",
    "test:renderer-timer-reset": "node scripts/test-renderer-timer-reset.js",
    "test:status-edit-event": "node scripts/test-status-edit-event.js",
    "test:status-watcher": "node scripts/test-status-watcher.js",
    "test:status-schema": "node scripts/test-status-schema.js",
    "test:app-composition": "node scripts/test-app-composition.js",
    "test:main-process": "node scripts/test-main-process.js",
    "test:pill-view": "node scripts/test-pill-view.js",
    "test:window-config": "node scripts/test-window-config.js",
    "test:notch-position": "node scripts/test-notch-position.js",
    "test:island-mode": "node scripts/test-island-mode.js",
    "test:hermes-status": "node scripts/test-hermes-status.js",
    "test:mac-activity-status": "node scripts/test-mac-activity-status.js",
    "test:youtube-media-bridge-content": "node scripts/test-youtube-media-bridge-content.js",
    "test:start-arc-media": "node scripts/test-start-arc-media.js",
    "test:enable-browser-apple-events": "node scripts/test-enable-browser-apple-events.js",
    "test:renderer-real-hermes-payload": "node scripts/test-renderer-real-hermes-payload.js",
    "test:renderer-compact-summary": "node scripts/test-renderer-compact-summary.js",
    "test:native-overlay-contract": "node scripts/test-native-overlay-contract.js",
    "test:native-timer-status-serialization": "npm run native:build && node scripts/test-native-timer-status-serialization.js",
    "test:native-timer-state-changes": "npm run native:build && node scripts/test-native-timer-state-changes.js",
    "test:browser-probe-isolation": "node scripts/test-browser-probe-isolation.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^42.3.3"
  }
}
