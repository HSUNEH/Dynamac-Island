{
  "name": "dynamac-island",
  "version": "0.1.0",
  "description": "Local macOS-testable Dynamic-Island-style status panel for Snuffles, Codex, and Ouroboros.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "npm run check-readme && npm run test:check-readme-script && npm run test:install-macbook-script && npm run test:package-mac-script && npm run test:packaged-status-path && npm run test:status-schema && npm run test:status-loader && npm run test:status-watcher && npm run test:status-edit-event && npm run test:app-state && npm run test:snuffles-state && npm run test:snuffles-view-model && npm run test:snuffles-ui-view && npm run test:codex-state && npm run test:codex-view-model && npm run test:codex-ui-view && npm run test:ouroboros-state && npm run test:ouroboros-view-model && npm run test:ouroboros-ui-view && npm run test:window-config && npm run test:pill-view && npm run test:app-composition && npm run test:main-process && npm run test:check-status-script && npm run test:check-status-valid-fixture && npm run test:check-status-malformed-fixture && npm run test:check-status-missing-required-fixture && npm run test:check-status-unsupported-state-fixture && npm run check-status && npm run check-status:valid",
    "check-readme": "node scripts/check-readme.js",
    "smoke:launch": "node scripts/smoke-launch.js",
    "setup:macbook": "bash scripts/install-macbook.sh",
    "package:mac": "node scripts/package-mac.js",
    "check-status": "node scripts/check-status.js",
    "check-status:valid": "node scripts/check-status.js fixtures/valid-status.json",
    "check-status:invalid": "node scripts/check-status.js fixtures/invalid-status.json",
    "check-status:malformed": "node scripts/check-status.js fixtures/malformed-status.json",
    "check-status:missing-required": "node scripts/check-status.js fixtures/missing-required-status.json",
    "check-status:unsupported-state": "node scripts/check-status.js fixtures/unsupported-state-status.json",
    "test:check-readme-script": "node scripts/test-check-readme-script.js",
    "test:install-macbook-script": "node scripts/test-install-macbook-script.js",
    "test:package-mac-script": "node scripts/test-package-mac-script.js",
    "test:packaged-status-path": "node scripts/test-packaged-status-path.js",
    "test:check-status-script": "node scripts/test-check-status-script.js",
    "test:check-status-malformed-fixture": "node scripts/test-check-status-malformed-fixture.js",
    "test:check-status-missing-required-fixture": "node scripts/test-check-status-missing-required-fixture.js",
    "test:check-status-unsupported-state-fixture": "node scripts/test-check-status-unsupported-state-fixture.js",
    "test:check-status-valid-fixture": "node scripts/test-check-status-valid-fixture.js",
    "test:codex-state": "node scripts/test-codex-state.js",
    "test:codex-ui-view": "node scripts/test-codex-ui-view.js",
    "test:codex-view-model": "node scripts/test-codex-view-model.js",
    "test:ouroboros-state": "node scripts/test-ouroboros-state.js",
    "test:ouroboros-ui-view": "node scripts/test-ouroboros-ui-view.js",
    "test:ouroboros-view-model": "node scripts/test-ouroboros-view-model.js",
    "test:snuffles-state": "node scripts/test-snuffles-state.js",
    "test:snuffles-ui-view": "node scripts/test-snuffles-ui-view.js",
    "test:snuffles-view-model": "node scripts/test-snuffles-view-model.js",
    "test:app-state": "node scripts/test-app-state.js",
    "test:status-loader": "node scripts/test-status-loader.js",
    "test:status-edit-event": "node scripts/test-status-edit-event.js",
    "test:status-watcher": "node scripts/test-status-watcher.js",
    "test:status-schema": "node scripts/test-status-schema.js",
    "test:app-composition": "node scripts/test-app-composition.js",
    "test:main-process": "node scripts/test-main-process.js",
    "test:pill-view": "node scripts/test-pill-view.js",
    "test:window-config": "node scripts/test-window-config.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "electron": "^42.3.3"
  }
}
