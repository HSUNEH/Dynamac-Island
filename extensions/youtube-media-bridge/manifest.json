{
  "manifest_version": 3,
  "name": "Dynamac YouTube Media Bridge",
  "version": "0.1.0",
  "description": "Sends YouTube player metadata to the local Dynamac media bridge.",
  "host_permissions": [
    "http://127.0.0.1:17654/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
